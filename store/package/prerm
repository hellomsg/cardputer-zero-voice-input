#!/bin/sh
set -eu
case "${1:-}" in
    remove|deconfigure)
        # Only touch accounts that opted into this application's per-user setup.
        # runuser ensures a malicious home-directory symlink cannot give this
        # package script root authority over user-controlled files.
        getent passwd | while IFS=: read -r name _ uid _ _ home _; do
            case "$uid" in ''|*[!0-9]*) continue;; esac
            [ "$uid" -ge 1000 ] || continue
            [ -f "$home/.local/share/voice-input/store-setup-v1" ] || continue
            runuser -u "$name" -- env HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" /usr/lib/voice-input/remove-user
        done
        ;;
esac
